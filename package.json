{
  "name": "cellblock",
  "version": "0.1.0",
  "description": "Cross-platform digital wellbeing app with high-accountability enforcement",
  "private": true,
  "workspaces": [
    "packages/*",
    "srv-back",
    "srv-front",
    "tests"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dirkpetersen/cellblock.git"
  },
  "author": "Dirk Petersen",
  "license": "MIT"
}
