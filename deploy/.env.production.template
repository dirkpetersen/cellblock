# CellBlock Production Environment Variables

# Environment
NODE_ENV=production

# Server
PORT=3000
HOST=0.0.0.0

# Database (Update with your PostgreSQL details)
DATABASE_URL="postgresql://cellblock:YOUR_DB_PASSWORD@localhost:5432/cellblock?schema=public"

# JWT (Generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_32_CHARS_OR_MORE
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/v1/auth/google/callback

# Email Service - Choose ONE provider

# Option 1: SendGrid (Recommended)
# Free tier: 100 emails/day
# Sign up: https://signup.sendgrid.com/
SENDGRID_API_KEY=SG.your-api-key-here
SENDGRID_FROM_EMAIL=noreply@cellblock.app

# Option 2: AWS SES (Alternative)
# Free tier: 62,000 emails/month
# Setup: https://console.aws.amazon.com/ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SES_FROM_EMAIL=noreply@cellblock.app

# Push Notifications

# APNs (iOS) - Required for iOS app
# Get from Apple Developer Portal
# Download .p8 key file and place in /home/cellblock/cellblock/keys/apns-key.p8
APNS_KEY_ID=ABC123XYZ
APNS_TEAM_ID=DEF456UVW
APNS_TOPIC=com.cellblock.app
APNS_KEY_PATH=/home/cellblock/cellblock/keys/apns-key.p8
APNS_PRODUCTION=true

# WNS (Windows) - Required for Windows app
# Get from Windows Dev Center
# https://partner.microsoft.com/dashboard/windows/overview
WNS_CLIENT_ID=ms-app://s-1-15-2-...
WNS_CLIENT_SECRET=your-wns-client-secret

# Frontend URL
FRONTEND_URL=https://dirkpetersen.github.io/cellblock

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WHITELIST_REQUESTS_PER_HOUR=10
RATE_LIMIT_BUDGET_REQUESTS_PER_HOUR=5

# Session
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
