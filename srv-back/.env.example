# Environment
NODE_ENV=development

# Server
PORT=3000
HOST=localhost

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cellblock?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email Service (choose one)
# AWS SES
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@cellblock.app

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@cellblock.app

# Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.cellblock.app
MAILGUN_FROM_EMAIL=noreply@cellblock.app

# Push Notifications
# APNs (iOS)
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_TOPIC=com.cellblock.app
APNS_PRODUCTION=false

# WNS (Windows)
WNS_CLIENT_ID=your-wns-client-id
WNS_CLIENT_SECRET=your-wns-client-secret

# Frontend URL
FRONTEND_URL=http://localhost:3001

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WHITELIST_REQUESTS_PER_HOUR=10
RATE_LIMIT_BUDGET_REQUESTS_PER_HOUR=5

# Session
SESSION_SECRET=your-session-secret-change-this
