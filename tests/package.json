{
  "name": "@cellblock/tests",
  "version": "0.1.0",
  "description": "CellBlock comprehensive test suite",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --testPathPattern='(unit|integration)'",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "playwright:install": "playwright install chromium firefox webkit",
    "playwright:install-deps": "playwright install-deps",
    "clean": "rm -rf coverage playwright-report test-results"
  },
  "dependencies": {
    "@cellblock/types": "*",
    "@cellblock/contracts": "*",
    "@prisma/client": "^5.7.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@nestjs/testing": "^10.3.0",
    "@playwright/test": "^1.40.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.3.1",
    "jest": "^29.7.0",
    "prisma": "^5.7.0",
    "socket.io-client": "^4.6.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@fixtures/(.*)$": "<rootDir>/fixtures/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1"
    },
    "testMatch": [
      "**/unit/**/*.spec.ts",
      "**/integration/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "../srv-back/src/**/*.(t|j)s",
      "!../srv-back/src/main.ts",
      "!../srv-back/src/**/*.module.ts",
      "!../srv-back/src/**/*.interface.ts",
      "!../srv-back/src/**/*.dto.ts"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 30000
  }
}
