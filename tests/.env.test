# Test Environment Variables
NODE_ENV=test

# Database (use separate test database)
DATABASE_URL="postgresql://cellblock:cellblock@localhost:5432/cellblock_test"

# API URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
API_BASE_URL=http://localhost:3000/api/v1

# JWT Secrets (test values)
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-only

# Email (mock in tests)
EMAIL_ENABLED=false
EMAIL_FROM=noreply@cellblock.test

# Google OAuth (mock in tests)
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret

# Test User Credentials
TEST_INMATE_EMAIL=inmate@test.com
TEST_INMATE_PASSWORD=TestPassword123!
TEST_WARDEN_EMAIL=warden@test.com
TEST_WARDEN_PASSWORD=TestPassword123!
