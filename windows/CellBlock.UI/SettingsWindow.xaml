<Window x:Class="CellBlock.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource Background}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                  Text="Settings"
                  FontSize="24"
                  FontWeight="Bold"
                  Foreground="{StaticResource BrandTeal}"
                  Margin="0,0,0,20"/>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- API Configuration -->
                <Border Background="{StaticResource BackgroundSecondary}"
                       CornerRadius="8"
                       Padding="16"
                       Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Server Configuration"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimary}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="API URL"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondary}"
                                  Margin="0,0,0,4"/>
                        <TextBox x:Name="ApiUrlTextBox"
                                Text="http://localhost:3000"
                                Padding="8"
                                Margin="0,0,0,12"/>

                        <TextBlock Text="Dashboard URL"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondary}"
                                  Margin="0,0,0,4"/>
                        <TextBox x:Name="DashboardUrlTextBox"
                                Text="http://localhost:3001"
                                Padding="8"
                                Margin="0,0,0,12"/>

                        <Button Content="Save Configuration"
                               Style="{StaticResource PrimaryButton}"
                               Click="SaveConfigButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Authentication -->
                <Border Background="{StaticResource BackgroundSecondary}"
                       CornerRadius="8"
                       Padding="16"
                       Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Authentication"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimary}"
                                  Margin="0,0,0,12"/>

                        <TextBlock x:Name="AuthStatusText"
                                  Text="Not logged in"
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondary}"
                                  Margin="0,0,0,12"/>

                        <Button Content="Log Out"
                               Style="{StaticResource SecondaryButton}"
                               Click="LogoutButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Background="{StaticResource BackgroundSecondary}"
                       CornerRadius="8"
                       Padding="16">
                    <StackPanel>
                        <TextBlock Text="About"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimary}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="CellBlock Windows Client"
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondary}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Version 1.0.0"
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondary}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="© 2024 CellBlock"
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Close Button -->
        <Button Grid.Row="2"
               Content="Close"
               Style="{StaticResource SecondaryButton}"
               Click="CloseButton_Click"
               Margin="0,20,0,0"
               HorizontalAlignment="Right"/>
    </Grid>
</Window>
